# Supabase project (Dashboard → Settings → API)
# Copy to .env.local — never commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Серверная соль для пароля клиентской сессии после 2FA (не NEXT_PUBLIC_)
CLIENT_AUTH_PEPPER=change-me-to-a-long-random-string

# service_role — ONLY server-side scripts outside this app; NEVER in client bundle
# Нужен для npm run seed:demo (локальное заполнение каталога)
SUPABASE_SERVICE_ROLE_KEY=
